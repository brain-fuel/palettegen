module main

-- A render-only entry for snapshots and model parity: print the page and
-- exit. The interactive static demo now builds ../_browser instead; that
-- entry also has a render-only mode accepted by the Node harness.
-- This minimal entry remains usable without syscall/js:
--
--   GOOS=js GOARCH=wasm go build -o app.wasm ./try
--   node tools/run_wasm.mjs app.wasm '?c=7C3AED'
--
-- Downloads are data: URLs baked into the page (Embed mode).

import "fmt"
import "os"
import "goforge.dev/palettegen/web"

let main () : Unit := do {
  let search := if len os.Args > 1 then os.Args[1] else "";
  let m := web.ModelFromQuery search true;
  fmt.Print (web.RenderPage m)
}
