module main

import "encoding/json"
import "fmt"
import "html"
import "strings"
import "syscall/js"
import "goforge.dev/palettegen/palette"
import "goforge.dev/palettegen/web"

let undoTrail := make (Slice String) 0
let undoIndex : Int := -1
let paletteJournal := make (Slice String) 0
let colorJournal := make (Slice String) 0

-- Undo groups a continuous gesture; the journal also retains intermediate
-- rendered palettes and sampled colors, including abandoned redo branches.
type SessionHistory := {
  Version : Int @[json "version"];
  Trail : Slice String @[json "trail"];
  Cursor : Int @[json "cursor"];
  Palettes : Slice String @[json "palettes"];
  Colors : Slice String @[json "colors"];
  Role : String @[json "role"]
}

let recent (values : Slice String) (value : String) (limit : Int) : Slice String := do {
  let mut out := make (Slice String) 0;
  for _, old in values do { if old != value then do { out := append out old } else () };
  out := append out value;
  let mut kept := make (Slice String) 0;
  for i, entry in out do { if i >= len out - limit then do { kept := append kept entry } else () };
  kept
}

let ignoreStorageFailure () : Unit := do { let _ := recover (); () }

let readSession () : String := do {
  defer ignoreStorageFailure ();
  let storage := (js.Global ()).Get "sessionStorage";
  let currentValue := storage.Call "getItem" "palettegen/session/v1";
  -- The obsolete name is read only to recover sessions from earlier builds.
  let value := if currentValue.IsNull () then storage.Call "getItem" "palette-forge/session/v1" else currentValue;
  if value.IsNull () then "" else value.String ()
}

let saveSession () : Unit := do {
  defer ignoreStorageFailure ();
  let state := SessionHistory { Version = 1, Trail = undoTrail, Cursor = undoIndex,
    Palettes = paletteJournal, Colors = colorJournal, Role = activeRole };
  let bytes, err := json.Marshal state;
  if err == nil then do {
    let storage := (js.Global ()).Get "sessionStorage";
    storage.Call "setItem" "palettegen/session/v1" (String bytes);
    -- Remove the old namespace only after the new session was stored.
    storage.Call "removeItem" "palette-forge/session/v1";
    ()
  } else ()
}

let journalColor (hex : String) : Unit := do {
  if palette.ParsedOk (palette.ParseHex hex) then do { colorJournal := recent colorJournal hex 256 } else ()
}

let journalPalette () : Unit := do {
  paletteJournal := recent paletteJournal current.QS 150
}

let historySwatch (hex : String) : String :=
  "<span class=\"history-swatch\" style=\"background:" + hex + "\"></span>"

let paintHistory () : Unit := do {
  (element "undo-palette").Set "disabled" (undoIndex <= 0);
  (element "redo-palette").Set "disabled" (undoIndex >= len undoTrail - 1);
  if (element "session-history").Get "hidden" |> jsBool then () else do {
    let mut rows := "";
    let mut i := len paletteJournal - 1;
    while i >= 0 do {
      let key := paletteJournal[i];
      let m := web.ModelFromQuery key current.Embed;
      let primary := web.PickerHex m;
      let secondary := if m.SecondaryHex == "" then "" else " + " + m.SecondaryHex;
      rows := rows + "<button type=\"button\" class=\"history-palette\" data-palette-key=\"" + html.EscapeString key + "\" aria-pressed=\"" + (if current.QS == key then "true" else "false") + "\">" + historySwatch primary + (if m.SecondaryHex == "" then "" else historySwatch m.SecondaryHex) + "<span>" + html.EscapeString (if m.Mode == "curated" then m.Pal.Name else primary + secondary) + "</span></button>";
      i := i - 1
    };
    (element "palette-history").Set "innerHTML" rows;
    rows := "";
    i := len colorJournal - 1;
    while i >= 0 do {
      let hex := colorJournal[i];
      rows := rows + "<button type=\"button\" class=\"history-color\" data-history-color=\"" + hex + "\" aria-label=\"Apply " + hex + "\">" + historySwatch hex + "<code>" + hex + "</code></button>";
      i := i - 1
    };
    (element "color-history").Set "innerHTML" rows;
    (element "history-role").Set "value" activeRole
  }
}

let commitPalette () : Unit := do {
  journalPalette ();
  if undoIndex < 0 || undoTrail[undoIndex] != current.QS then do {
    let mut trail := make (Slice String) 0;
    for i, key in undoTrail do { if i <= undoIndex then do { trail := append trail key } else () };
    trail := append trail current.QS;
    undoTrail := make (Slice String) 0;
    for i, key in trail do { if i >= len trail - 100 then do { undoTrail := append undoTrail key } else () };
    undoIndex := len undoTrail - 1;
    ((js.Global ()).Get "history").Call "pushState" nil "" (canonicalURL current);
    ()
  } else ();
  paintHistory ();
  saveSession ()
}

let restorePalette (key : String) : Unit := do {
  hideSelectionNotice ();
  secondaryRemovalPending := false;
  let m := web.ModelFromQuery (key + (if current.Theme == "" then "" else "&t=" + current.Theme)) current.Embed;
  renderModel m false;
  ((js.Global ()).Get "history").Call "replaceState" nil "" (canonicalURL current);
  paintHistory (); saveSession ();
  textAt "result-status" "Earlier palette restored. Continue exploring, or view the palette."
}

-- Browser navigation and editor undo share a cursor without creating a
-- replacement browser entry. Revisited colors remain in the session journal.
let navigatedPalette () : Unit := do {
  let mut nearest := -1;
  let mut distance := len undoTrail + 1;
  for i, key in undoTrail do {
    let delta := if i > undoIndex then i - undoIndex else undoIndex - i;
    if key == current.QS && delta < distance then do { nearest := i; distance := delta } else ()
  };
  if nearest >= 0 then do { undoIndex := nearest } else do {
    undoTrail := append undoTrail current.QS;
    let mut kept := make (Slice String) 0;
    for i, key in undoTrail do { if i >= len undoTrail - 100 then do { kept := append kept key } else () };
    undoTrail := kept;
    undoIndex := len undoTrail - 1
  };
  journalPalette (); paintHistory (); saveSession ()
}

let undoPalette (event : js.Value) : Any := do {
  flushLive (); commitPalette ();
  if undoIndex > 0 then do { undoIndex := undoIndex - 1; restorePalette undoTrail[undoIndex] } else ();
  nil
}

let redoPalette (event : js.Value) : Any := do {
  flushLive ();
  if undoIndex < len undoTrail - 1 then do { undoIndex := undoIndex + 1; restorePalette undoTrail[undoIndex] } else ();
  nil
}

let toggleHistory (event : js.Value) : Any := do {
  let opened := (element "session-history").Get "hidden" |> jsBool;
  show "session-history" opened;
  (element "open-history").Call "setAttribute" "aria-expanded" (if opened then "true" else "false");
  paintHistory ();
  if opened then do { (element "session-history").Call "scrollIntoView"; () } else ();
  nil
}

let closeHistory (event : js.Value) : Any := do {
  show "session-history" false;
  (element "open-history").Call "setAttribute" "aria-expanded" "false";
  nil
}

let loadHistory (hasQuery : Bool) : Unit := do {
  let raw := readSession ();
  let state := SessionHistory { Version = 0, Trail = make (Slice String) 0, Cursor = -1,
    Palettes = make (Slice String) 0, Colors = make (Slice String) 0, Role = "primary" };
  let err := json.Unmarshal (Slice Byte raw) &state;
  if err == nil && state.Version == 1 then do {
    for i, key in state.Trail do {
      if i >= len state.Trail - 100 then do { undoTrail := append undoTrail (web.ModelFromQuery key current.Embed).QS } else ()
    };
    undoIndex := state.Cursor - (len state.Trail - len undoTrail);
    if undoIndex < 0 || undoIndex >= len undoTrail then do { undoIndex := len undoTrail - 1 } else ();
    for _, key in state.Palettes do { paletteJournal := recent paletteJournal (web.ModelFromQuery key current.Embed).QS 150 };
    for _, hex in state.Colors do {
      let parsed := palette.ParseHex hex;
      if palette.ParsedOk parsed then journalColor (palette.ParsedShade parsed).Hex else ()
    };
    if state.Role == "secondary" then do { activeRole := "secondary" } else ();
    if !hasQuery && undoIndex >= 0 then renderModel (web.ModelFromQuery undoTrail[undoIndex] current.Embed) false else ()
  } else ();
  if undoIndex < 0 then do { undoTrail := append undoTrail current.QS; undoIndex := 0 }
  else if undoTrail[undoIndex] != current.QS then commitPalette () else ();
  if len colorJournal == 0 then do {
    journalColor (web.PickerHex current);
    if current.SecondaryHex != "" then journalColor current.SecondaryHex else ()
  } else ();
  journalPalette (); paintHistory (); saveSession ()
}
