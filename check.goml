module main

-- Self-checks, in goml: `paletteforge check` (or `make check`) runs them
-- and exits non-zero on failure.

import "fmt"
import "io"
import "strings"
import "goforge.dev/palettegen/palette"

let check (name : String) (ok : Bool) : Int :=
  if ok then 0 else do {
    fmt.Println ("FAIL: " + name);
    1
  }

let shadesMonotonic (sc : palette.Scale) : Bool := do {
  let mut good := true;
  let mut i := 1;
  while i < len sc.Shades do {
    if sc.Shades[i].L <= sc.Shades[i - 1].L then do { good := false } else ();
    i := i + 1
  };
  good
}

let anchorPreserved (base : palette.Shade) (sc : palette.Scale) : Bool := do {
  let mut found := false;
  for _, sh in sc.Shades do {
    if sh.H == base.H && sh.S == base.S && sh.L == base.L then do { found := true } else ()
  };
  found
}

let allTenShades (scales : Slice palette.Scale) : Bool := do {
  let mut good := true;
  for _, sc in scales do {
    if len sc.Shades != 10 then do { good := false } else ()
  };
  good
}

let foundScale (ms : MaybeScale) : Bool :=
  match ms with
  | ScaleSome _ => true
  | ScaleNone => false

let RunChecks () : Int := do {
  let mut fails := 0;

  -- Book data intact
  fails := fails + check "24 curated palettes" (len (palette.Curated ()) == 24);
  fails := fails + check "30 reference scales" (len (palette.Reference ()) == 30);
  fails := fails + check "reference scales all have 10 shades" (allTenShades (palette.Reference ()));
  fails := fails + check "seed pool excludes greys" (len (palette.ColorSeeds ()) == 26);

  -- Palette 1 verbatim
  let p1 := palette.FromCurated 1;
  fails := fails + check "palette 1 primary is Cyan" (len p1.Primary == 1 && p1.Primary[0].Name == "Cyan");
  fails := fails + check "palette 1 darkest cyan is #044E54" (p1.Primary[0].Shades[0].Hex == "#044E54");
  fails := fails + check "palette 1 has 4 supporting scales" (len p1.Supporting == 4);

  -- Hex parsing round-trip against the book's own rounding
  let parsed := palette.ParseHex "#2CB1BC";
  fails := fails + check "parse #2CB1BC ok" (palette.ParsedOk parsed);
  let sh := palette.ParsedShade parsed;
  fails := fails + check "hsl of #2CB1BC is (185, 62, 45)" (sh.H == 185.0 && sh.S == 62.0 && sh.L == 45.0);
  fails := fails + check "short and unhashed hex parse" (palette.ParsedOk (palette.ParseHex "fff") && palette.ParsedOk (palette.ParseHex "7C3AED"));
  fails := fails + check "garbage hex rejected" (!(palette.ParsedOk (palette.ParseHex "zzz")) && !(palette.ParsedOk (palette.ParseHex "#12345")));

  -- Generation
  let red := palette.ParsedShade (palette.ParseHex "#D64545");
  let gen := palette.Generate red;
  fails := fails + check "generated primary has 10 shades" (len gen.Primary == 1 && len gen.Primary[0].Shades == 10);
  fails := fails + check "generated primary lightness is monotonic" (shadesMonotonic gen.Primary[0]);
  fails := fails + check "requested color survives as an anchor shade" (anchorPreserved red gen.Primary[0]);
  fails := fails + check "red primary keeps warm grey neutrals" (len gen.Neutrals == 1 && gen.Neutrals[0].Name == "Warm Grey");
  fails := fails + check "red primary skips the red semantic scale" (len gen.Supporting == 3);

  -- Context demos and theming
  let pool := contextScales gen;
  fails := fails + check "success alert scale found" (foundScale (findScale pool isSuccessHue));
  fails := fails + check "warning alert scale found" (foundScale (findScale pool isWarningHue));
  fails := fails + check "danger falls back to the red primary" (foundScale (findScale pool isDangerHue));
  fails := fails + check "theme sanitizer" (sanitizeTheme "dark" == "dark" && sanitizeTheme "light" == "light" && sanitizeTheme "purple" == "");
  fails := fails + check "html escaping" (escapeHTML "a<b>&c" == "a&lt;b&gt;&amp;c");

  -- Chrome wears the selected palette
  let genTheme := ThemeCSS gen;
  fails := fails + check "chrome tokens come from the generated palette" (strings.Contains genTheme gen.Primary[0].Shades[2].Hex && strings.Contains genTheme gen.Neutrals[0].Shades[0].Hex);
  fails := fails + check "chrome has light, auto-dark and pinned-dark blocks" (strings.Contains genTheme "@media (prefers-color-scheme: dark)" && strings.Contains genTheme ":root[data-theme=dark]");
  fails := fails + check "palette 1 chrome keeps the cyan accent" (strings.Contains (ThemeCSS p1) "--accent: #0E7C86");

  -- Demo controls are no-ops: no hash links, demo buttons never submit
  let page := renderPage (curatedModel 1 "" "");
  fails := fails + check "no href=# anchors on the page" (!(strings.Contains page "href=\"#\""));
  fails := fails + check "demo buttons are type=button" (strings.Contains page "<button type=\"button\" class=\"demo-btn\"");
  fails := fails + check "demo form fields are real inputs" (strings.Contains page "class=\"mock-input\" placeholder=");

  -- goforge.dev-style project metadata on the landing page
  fails := fails + check "hero carries version pill and install command" (strings.Contains page Version && strings.Contains page "go install goforge.dev/palettegen@latest");
  fails := fails + check "hero links repo and pkg.go.dev" (strings.Contains page "github.com/brain-fuel/palettegen" && strings.Contains page "pkg.go.dev/goforge.dev/palettegen");

  -- Embedded fonts decode to real woff2
  fails := fails + check "overpass 700 decodes as woff2" (len overpass700 > 1000 && strings.HasPrefix (String overpass700) "wOF2");
  fails := fails + check "atkinson faces decode as woff2" (strings.HasPrefix (String atkinson400) "wOF2" && strings.HasPrefix (String atkinson700) "wOF2" && strings.HasPrefix (String atkinson400i) "wOF2");
  fails := fails + check "stylesheet wires both families" (strings.Contains stylesheet "font-family: 'Overpass'" && strings.Contains stylesheet "'Atkinson Hyperlegible'");
  fails := fails + check "unknown font path yields empty" (len (fontFor "/fonts/nope.woff2") == 0);

  -- Outputs
  fails := fails + check "json export is non-empty" (len (palette.ToJSON gen) > 500);
  let pdfErr := palette.WritePDF io.Discard gen;
  fails := fails + check "pdf renders without error" (pdfErr == nil);

  if fails == 0
    then fmt.Println "all checks passed"
    else fmt.Printf "%d check(s) failed\n" fails;
  fails
}
