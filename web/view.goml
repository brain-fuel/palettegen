module web

-- The page, rendered server-side as HTML. One screen, one purpose
-- (Natoli); concise controls up top, consistent landmarks, and
-- teaching-by-role captions (Winston); whitespace and soft depth over
-- chrome (Leonardo) - the swatches themselves are the art.
--
-- The in-context tiles keep their inline palette colors in both color
-- schemes: they demonstrate the generated palette, not the app's chrome.

import "bytes"
import "encoding/base64"
import "fmt"
import "html"
import "strings"
import "goforge.dev/palettegen/palette"

let inkFor (sh : palette.Shade) : String :=
  if palette.LumaOf sh > 150.0 then "#102A43" else "#FFFFFF"

let hslLabel (sh : palette.Shade) : String :=
  fmt.Sprintf "hsl(%d, %d%%, %d%%)" (Int sh.H) (Int sh.S) (Int sh.L)

let escapeHTML (s : String) : String := html.EscapeString s

let swatchCell (sh : palette.Shade) : String :=
  "<div class=\"sw\" style=\"background:" + sh.Hex + ";color:" + inkFor sh + "\">" +
    "<span class=\"sw-hex\">" + sh.Hex + "</span>" +
    "<span class=\"sw-hsl\">" + hslLabel sh + "</span>" +
    "</div>"

let scaleID (role : String) (index : Int) : String :=
  fmt.Sprintf "scale-%s-%d" (strings.ToLower role) index

let scaleBlock (id : String) (sc : palette.Scale) : String := do {
  let mut cells := "";
  for _, sh in sc.Shades do { cells := cells + swatchCell sh };
  "<div class=\"scale\">" +
    "<div class=\"scale-head\"><h4 id=\"" + id + "\" tabindex=\"-1\">" + sc.Name + "</h4>" +
    "<span class=\"scale-range\">900 &#8594; 50 &#183; darkest to lightest</span></div>" +
    "<div class=\"scale-grid\">" + cells + "</div>" +
    "</div>"
}

let categorySection (title : String) (caption : String) (scales : Slice palette.Scale) : String := do {
  let mut blocks := "";
  for i, sc in scales do { blocks := blocks + scaleBlock (scaleID title i) sc };
  "<section class=\"category\"><h3>" + title + "</h3>" +
    "<p class=\"caption\">" + caption + "</p>" + blocks + "</section>"
}

let previewScales (role : String) (scales : Slice palette.Scale) : String := do {
  let mut out := "";
  for i, sc in scales do {
    let mut stops := "";
    for j, shade in sc.Shades do {
      if j > 0 then do { stops := stops + "," } else ();
      stops := stops + fmt.Sprintf "%s %.2f%%" shade.Hex (Float64 j * 100.0 / Float64 (len sc.Shades - 1))
    };
    let label := escapeHTML (role + " · " + sc.Name);
    let target := scaleID role i;
    out := out + "<a class=\"preview-scale\" href=\"#" + target + "\" data-scale-target=\"" + target + "\" data-preview-label=\"" + label + "\" aria-label=\"" + label + ", 900 to 50. Jump to full scale.\" title=\"" + label + " · 900 to 50\">" +
      "<span class=\"preview-strip\" style=\"background:linear-gradient(to right," + stops + ")\" aria-hidden=\"true\"></span><span class=\"preview-name\">" + label + "</span></a>"
  };
  out
}

let palettePreview (p : palette.Palette) : String :=
  "<aside id=\"palette-preview\" class=\"palette-preview\" aria-label=\"Live palette preview\"><p id=\"preview-hover-label\" class=\"preview-hover-label\" aria-hidden=\"true\" hidden></p>" +
    "<div class=\"preview-range\"><span>900</span><span>50</span></div><nav class=\"preview-list\" aria-label=\"Jump to a color scale\">" +
    previewScales "Primary" p.Primary + previewScales "Secondary" p.Secondary +
    previewScales "Neutrals" p.Neutrals + previewScales "Supporting" p.Supporting + "</nav></aside>"

-- ---- in-context demos: near-miss teachers -------------------------------

@[derive off]
type MaybeScale :=
  | ScaleSome (Sc : palette.Scale)
  | ScaleNone

let isDangerHue (h : Float64) : Bool := h < 35.0 || h >= 330.0
let isWarningHue (h : Float64) : Bool := h >= 35.0 && h < 80.0
let isSuccessHue (h : Float64) : Bool := h >= 80.0 && h < 170.0

-- Supporting scales first, then primaries: when a semantic scale was
-- skipped because the primary already owns that hue, the primary serves.
let contextScales (p : palette.Palette) : Slice palette.Scale := do {
  let mut out := make (Slice palette.Scale) 0;
  for _, sc in p.Supporting do { out := append out sc };
  for _, sc in p.Primary do { out := append out sc };
  out
}

let findScale (scales : Slice palette.Scale) (pred : Float64 -> Bool) : MaybeScale := do {
  for _, sc in scales do {
    if len sc.Shades == 10 && pred sc.Shades[4].H then do { return ScaleSome sc } else ()
  };
  ScaleNone
}

let alertHTML (sc : palette.Scale) (leadIn : String) (rest : String) : String := do {
  let sh := sc.Shades;
  "<div class=\"alert\" style=\"background:" + sh[9].Hex + ";border-left:4px solid " + sh[4].Hex +
    ";color:" + sh[1].Hex + "\"><strong>" + leadIn + "</strong> " + rest + "</div>"
}

let alertRow (ms : MaybeScale) (leadIn : String) (rest : String) : String :=
  match ms with
  | ScaleSome sc => alertHTML sc leadIn rest
  | ScaleNone => ""

let tile (label : String) (body : String) : String :=
  "<div class=\"tile\"><span class=\"tile-label\">" + label + "</span>" + body + "</div>"

let chipFor (p : palette.Palette) : String := do {
  if len p.Secondary > 0 then do {
    let sh := p.Secondary[0].Shades;
    "<span class=\"chip\" style=\"background:" + sh[8].Hex + ";color:" + sh[1].Hex + "\">Featured collection</span>"
  } else if len p.Supporting == 0 then "" else do {
    let su := p.Supporting[len p.Supporting - 1].Shades;
    "<span class=\"chip\" style=\"background:" + su[8].Hex + ";color:" + su[1].Hex + "\">On track</span>"
  }
}

-- The same card twice: once on a light ground, once on a dark one. The
-- point is the near miss - a palette that only works on white is not done.
let demoCard (p : palette.Palette) (dark : Bool) : String := do {
  let pr := p.Primary[0].Shades;
  let nu := p.Neutrals[0].Shades;
  let ground := if dark then nu[0].Hex else nu[8].Hex;
  let card := if dark then nu[1].Hex else "#FFFFFF";
  let head := if dark then nu[9].Hex else nu[0].Hex;
  let body := if dark then nu[7].Hex else nu[3].Hex;
  let ghostInk := if dark then pr[7].Hex else pr[2].Hex;
  "<div class=\"tile-body ground\" style=\"background:" + ground + "\">" +
    "<div class=\"demo-card\" style=\"background:" + card + "\">" +
    "<h3 style=\"color:" + head + ";margin:0\">Quarterly report</h3>" +
    "<p style=\"color:" + body + "\">Revenue is up 12% since the redesign shipped. The board wants details Thursday.</p>" +
    chipFor p +
    "<div class=\"demo-actions\">" +
    "<button type=\"button\" class=\"demo-btn\" style=\"background:" + pr[4].Hex + ";color:" + inkFor pr[4] + "\">Share report</button>" +
    "<button type=\"button\" class=\"demo-btn\" style=\"background:transparent;color:" + ghostInk + ";box-shadow: inset 0 0 0 1.5px " + pr[4].Hex + "\">Export</button>" +
    "</div></div></div>"
}

let alertsTile (p : palette.Palette) : String := do {
  let pool := contextScales p;
  let nu := p.Neutrals[0].Shades;
  let rows :=
    alertRow (findScale pool isSuccessHue) "Saved." "Your palette is safely in the export." +
    alertRow (findScale pool isWarningHue) "Heads up." "Very light text needs the darker shades to stay readable." +
    alertRow (findScale pool isDangerHue) "Export failed." "The disk is full; nothing was written.";
  let content := if rows == "" then "<p class=\"caption\">This palette carries no semantic hues.</p>" else rows;
  "<div class=\"tile-body ground\" style=\"background:" + nu[9].Hex + "\">" + content + "</div>"
}

let navTile (p : palette.Palette) : String := do {
  let pr := p.Primary[0].Shades;
  "<div class=\"tile-body\"><div class=\"nav-demo\" style=\"background:" + pr[0].Hex + "\">" +
    "<strong style=\"color:" + pr[9].Hex + "\">PaletteGen</strong>" +
    "<a style=\"color:" + pr[7].Hex + "\">Overview</a>" +
    "<a style=\"background:" + pr[4].Hex + ";color:" + inkFor pr[4] + "\">Reports</a>" +
    "<a style=\"color:" + pr[7].Hex + "\">Settings</a>" +
    "</div></div>"
}

let typeTile (p : palette.Palette) : String := do {
  let nu := p.Neutrals[0].Shades;
  "<div class=\"tile-body ground type-demo\" style=\"background:" + nu[9].Hex + "\">" +
    "<p style=\"color:" + nu[0].Hex + ";font-size:20px;font-weight:700\">Dashboard</p>" +
    "<p style=\"color:" + nu[3].Hex + "\">Hierarchy comes from the greys: darkest for headings, mid for body text.</p>" +
    "<p style=\"color:" + nu[5].Hex + ";font-size:13px\">Caption and metadata &#183; updated 12 minutes ago</p>" +
    "</div>"
}

let formTile (p : palette.Palette) : String := do {
  let pr := p.Primary[0].Shades;
  let nu := p.Neutrals[0].Shades;
  "<div class=\"tile-body ground\" style=\"background:" + nu[9].Hex + "\">" +
    "<label style=\"color:" + nu[2].Hex + "\">Work email</label>" +
    "<input type=\"text\" class=\"mock-input\" placeholder=\"you@example.com\" aria-label=\"Work email (demo)\" style=\"background:#FFFFFF;border:1px solid " + nu[6].Hex + ";color:" + nu[1].Hex + "\">" +
    "<label style=\"color:" + nu[2].Hex + "\">Team name (focused)</label>" +
    "<input type=\"text\" class=\"mock-input\" value=\"Design systems\" aria-label=\"Team name (demo)\" style=\"background:#FFFFFF;border:1px solid " + pr[4].Hex + ";box-shadow:0 0 0 3px " + pr[8].Hex + ";color:" + nu[1].Hex + "\">" +
    "<button type=\"button\" class=\"demo-btn\" style=\"background:" + pr[4].Hex + ";color:" + inkFor pr[4] + "\">Create team</button>" +
    "</div>"
}

let contextSection (p : palette.Palette) : String := do {
  if len p.Primary == 0 || len p.Neutrals == 0 then "" else do {
    if len p.Primary[0].Shades != 10 || len p.Neutrals[0].Shades != 10 then "" else
      "<section id=\"examples\" class=\"category\" aria-labelledby=\"examples-heading\"><h3 id=\"examples-heading\" tabindex=\"-1\">In context</h3>" +
        "<p class=\"caption\">A palette only proves itself in use. The same colors doing their actual jobs - and doing them on light and dark grounds alike.</p>" +
        "<div class=\"context-grid\">" +
        tile "On a light ground" (demoCard p false) +
        tile "On a dark ground" (demoCard p true) +
        tile "Semantic alerts" (alertsTile p) +
        tile "Text hierarchy" (typeTile p) +
        tile "Navigation" (navTile p) +
        tile "Forms &amp; focus" (formTile p) +
        "</div></section>"
  }
}

-- ---- chrome -------------------------------------------------------------

let themeLink (m : Model) (value : String) (label : String) : String := do {
  let href := if value == "" then "?" + m.QS else "?" + m.QS + "&amp;t=" + value;
  let cls := if m.Theme == value then " class=\"on\"" else "";
  "<a" + cls + " href=\"" + href + "\">" + label + "</a>"
}

let ThemeLinks (m : Model) : String :=
    themeLink m "" "Auto" +
    themeLink m "light" "Light" +
    themeLink m "dark" "Dark"

let themeToggle (m : Model) : String :=
  "<nav id=\"theme-links\" class=\"theme-toggle\" aria-label=\"Color scheme\">" + ThemeLinks m + "</nav>"

let themeField (m : Model) : String :=
  if m.Theme == "" then ""
  else "<input type=\"hidden\" name=\"t\" value=\"" + m.Theme + "\">"

let curatedOptions (selectedID : Int) : String := do {
  let mut out := "";
  for _, b in palette.Curated () do {
    let mark := if b.ID == selectedID then " selected" else "";
    let mut names := "";
    for _, sc in b.Primary do {
      names := if names == "" then sc.Name else names + " + " + sc.Name
    };
    out := out + fmt.Sprintf "<option value=\"%d\"%s>Palette %d &#183; %s</option>" b.ID mark b.ID names
  };
  out
}

let secondaryFields (m : Model) : String := do {
  let expanded := if m.SecondaryHex != "" then " open" else "";
  let valid : Bool := palette.ParsedOk (palette.ParseHex m.SecondaryHex);
  let hx := if valid then m.SecondaryHex else "#E87924";
  let mut absent : String := " hidden";
  if valid then do { absent := "" } else ();
  let mut sectionClass : String := "secondary-section";
  let mut summaryLabel : String := "Add a secondary color";
  let mut optionalHidden : String := "";
  if m.SecondaryHex != "" then do { sectionClass := sectionClass + " has-secondary"; summaryLabel := "Secondary color"; optionalHidden := " hidden" } else ();
  "<div id=\"secondary-section\" class=\"" + sectionClass + "\"><details id=\"secondary-controls\" class=\"secondary-controls\"" + expanded + "><summary><span id=\"secondary-summary-label\">" + summaryLabel + "</span> " +
    "<span id=\"secondary-optional\" class=\"optional\"" + optionalHidden + ">optional</span>" +
    "<span id=\"secondary-summary-color\" class=\"secondary-summary-color\" style=\"background:" + hx + "\" title=\"" + hx + "\" role=\"img\" aria-label=\"Secondary " + hx + "\"" + absent + "></span><code id=\"secondary-summary-hex\"" + absent + ">" + hx + "</code></summary>" +
    "<div class=\"color-row\"><label id=\"secondary-picker-field\" class=\"field enhanced\" hidden><span>Secondary color</span><input id=\"secondary-picker\" type=\"color\" value=\"" + hx + "\"></label>" +
    "<label class=\"field hex-field\"><span>Secondary hex</span><input id=\"secondary-hex\" type=\"text\" name=\"s\" value=\"" + escapeHTML m.SecondaryHex + "\" placeholder=\"#E87924\" pattern=\"#?[0-9a-fA-F]{3}([0-9a-fA-F]{3})?\" maxlength=\"7\" autocapitalize=\"off\" spellcheck=\"false\" aria-describedby=\"pairing-note\"></label>" +
    "<button id=\"clear-secondary\" type=\"button\" class=\"text-button enhanced\" hidden>Remove</button></div>" +
    "<p id=\"pairing-note\" class=\"field-help feedback\" data-tone=\"" + PairingTone m + "\" aria-live=\"polite\">" + FeedbackHTML (PairingTone m) (PairingGuidance m) + "</p></details><button id=\"clear-secondary-collapsed\" type=\"button\" class=\"text-button secondary-collapsed-remove\" aria-label=\"Remove secondary color\" hidden>Remove</button></div>"
}

let picturePanel () : String :=
  "<section id=\"image-panel\" class=\"image-panel\" aria-labelledby=\"picture-title\"><h2 id=\"picture-title\" class=\"editor-heading\" tabindex=\"-1\">Pick from a picture</h2>" +
    "<p id=\"image-availability\" class=\"field-help feedback\" data-tone=\"loading\" role=\"status\">Image picking is loading. You can choose colors manually below.</p>" +
    "<noscript><p class=\"field-help\">Image picking needs WebAssembly and browser scripting. You can enter primary and secondary hex colors below.</p></noscript>" +
    "<div id=\"image-tools\" hidden>" +
    "<div id=\"drop-zone\" class=\"drop-zone picture-frame\"><div id=\"picture-placeholder\"><label class=\"field\" for=\"image-file\"><span class=\"sr-only\">Upload a picture</span><input id=\"image-file\" type=\"file\" accept=\"image/*\"></label>" +
    "<p class=\"field-help\">Or drop a picture here &#183; 20 MB max.</p></div>" +
    "<div id=\"picture-viewport\" hidden><canvas id=\"picture\" tabindex=\"0\" role=\"img\" hidden aria-label=\"Your picture. Tap to preview, drag to pan, pinch or use plus and minus to zoom. Shift and arrow keys pan; arrow keys fine-tune; zero fits the picture.\"></canvas><span id=\"picture-marker\" class=\"picture-marker\" hidden></span></div>" +
    "<nav id=\"picture-zoom\" class=\"picture-zoom\" aria-label=\"Picture zoom\" hidden><button id=\"picture-zoom-in\" type=\"button\" class=\"ghost\" aria-label=\"Zoom in\">+</button><button id=\"picture-zoom-out\" type=\"button\" class=\"ghost\" aria-label=\"Zoom out\">−</button><button id=\"picture-fit\" type=\"button\" class=\"ghost\" aria-label=\"Fit whole picture\">Fit</button></nav></div>" +
    "<div id=\"picture-command-row\" class=\"picture-command-row\" hidden><button id=\"change-picture\" type=\"button\" class=\"text-button\" aria-expanded=\"false\" aria-controls=\"picture-source-options\">Change picture</button><button id=\"clear-picture\" type=\"button\" class=\"text-button\">Remove picture</button></div>" +
    "<div id=\"picture-source-options\"><button id=\"choose-replacement\" type=\"button\" class=\"ghost\" hidden>Choose a picture</button>" +
    "<div class=\"clipboard-row\"><button id=\"paste-picture\" type=\"button\" class=\"ghost\">Paste image</button>" +
    "<p class=\"field-help\">or Cmd/Ctrl+V</p></div>" +
    "<details id=\"image-url-options\" class=\"image-url-options\"><summary>Use an image link</summary>" +
    "<form id=\"image-url-form\" class=\"image-url-form\"><label class=\"field\" for=\"image-url\"><span>Direct image URL</span>" +
    "<input id=\"image-url\" type=\"url\" placeholder=\"https://example.com/photo.jpg\" autocomplete=\"off\" spellcheck=\"false\" required aria-describedby=\"url-help\"></label>" +
    "<button type=\"submit\" class=\"ghost\">Load picture</button></form>" +
    "<p id=\"url-help\" class=\"field-help\">Use a direct HTTPS image link. Some websites restrict access to image colors.</p></details></div>" +
    "<p id=\"image-status\" class=\"field-help feedback\" role=\"status\" aria-live=\"polite\"></p>" +
    "<div id=\"picture-workspace\" hidden><div class=\"sample-row\"><div class=\"precision-sample\"><h4>Fine-tune a pixel</h4><canvas id=\"magnifier\" width=\"132\" height=\"132\" tabindex=\"0\" role=\"img\" aria-disabled=\"true\" aria-label=\"Magnified pixels. Tap or drag to select an exact color. Arrow keys move one pixel.\" aria-describedby=\"zoom-help\"></canvas>" +
    "<p id=\"zoom-help\" class=\"sr-only\">Tap the picture to see its pixels here.</p></div>" +
    "<div class=\"sample-actions\"><p id=\"sampling-role\" class=\"field-help\" role=\"status\">Choose a picture color</p><output id=\"sample-hex\" aria-live=\"polite\">Choose a color</output><div class=\"assign-actions\" role=\"group\" aria-label=\"Assign the previewed color\">" +
    "<button id=\"pick-primary\" type=\"button\" class=\"ghost\" disabled aria-pressed=\"false\" aria-describedby=\"sampling-role\">Use as Primary</button><div class=\"secondary-role-actions\"><button id=\"pick-secondary\" type=\"button\" class=\"ghost\" disabled aria-pressed=\"false\" aria-describedby=\"sampling-role\">Use as Secondary</button>" +
    "<button id=\"remove-sample-secondary\" type=\"button\" class=\"text-button\" hidden>Remove secondary</button></div></div></div></div>" +
    "<h4 class=\"suggestion-heading\">Or choose a suggested color</h4><div id=\"image-suggestions\" class=\"image-suggestions\" aria-label=\"Suggested image colors\"></div>" +
    "</div></div></section>"

let controls (m : Model) : String :=
  "<div class=\"controls\">" +
    "<section id=\"session-history\" class=\"session-history\" hidden aria-labelledby=\"history-title\"><div class=\"history-head\"><h2 id=\"history-title\" class=\"editor-heading\">Session history</h2><button id=\"close-history\" type=\"button\" class=\"text-button\">Close</button></div>" +
    "<p class=\"field-help\">Restore an earlier palette or color. Saved in this tab for this session.</p><h3>Palettes</h3><div id=\"palette-history\" class=\"palette-history\"></div>" +
    "<h3>Colors</h3><label class=\"field history-role-field\"><span>Apply colors to</span><select id=\"history-role\"><option value=\"primary\">Primary</option><option value=\"secondary\">Secondary</option></select></label><div id=\"color-history\" class=\"color-history\"></div></section>" +
    picturePanel () +
    "<section class=\"manual-editor\" aria-labelledby=\"manual-title\"><h2 id=\"manual-title\" class=\"editor-heading\">Or choose colors manually</h2><p class=\"field-help\">Use a color picker or enter a hex value.</p>" +
    "<form id=\"generate-form\" class=\"gen\" method=\"get\">" +
    themeField m +
    "<div class=\"color-row\"><label class=\"field\"><span>Primary color</span>" +
    "<input id=\"primary-picker\" type=\"color\" name=\"c\" value=\"" + pickerHex m + "\"></label>" +
    "<label class=\"field hex-field\"><span>Hex value</span>" +
    "<input id=\"primary-hex\" type=\"text\" name=\"hx\" placeholder=\"" + pickerHex m + "\" maxlength=\"7\" autocapitalize=\"off\" spellcheck=\"false\" " +
    "pattern=\"#?[0-9a-fA-F]{3}([0-9a-fA-F]{3})?\"></label></div>" +
    secondaryFields m +
    "<button id=\"manual-apply\" class=\"primary\" type=\"submit\">Apply colors</button>" +
    "</form>" +
    "<details class=\"curated-options\"><summary>Use a curated palette</summary><form id=\"curated-form\" class=\"curated\" method=\"get\">" +
    themeField m +
    "<input id=\"curated-secondary\" type=\"hidden\" name=\"s\" value=\"" + escapeHTML m.SecondaryHex + "\">" +
    "<label class=\"field\"><span>Book palette</span>" +
    "<select id=\"curated-id\" name=\"p\">" + curatedOptions m.CuratedID + "</select></label>" +
    "<button id=\"curated-apply\" class=\"ghost\" type=\"submit\">Open book palette</button>" +
    "</form></details></section>" +
    "</div>"

let jsonSection (m : Model) : String :=
  "<section class=\"category\"><h3>Take it with you</h3>" +
    "<p class=\"caption\">The buttons above download files; this block is for pasting straight into a tailwind config, a theme file, or a teammate's chat.</p>" +
    "<details class=\"json-view\"><summary>Show the JSON</summary>" +
    "<pre><code>" + escapeHTML (String (palette.ToJSON m.Pal)) + "</code></pre>" +
    "</details></section>"

let b64OfBytes (bs : Slice Byte) : String := do {
  let enc := base64.StdEncoding;
  enc.EncodeToString bs
}

let noBuf () : Slice Byte := make (Slice Byte) 0

let pdfDataURL (p : palette.Palette) : String := do {
  let buf := bytes.NewBuffer (noBuf ());
  let err := palette.WritePDF buf p;
  if err != nil then "" else "data:application/pdf;base64," + b64OfBytes (buf.Bytes ())
}

let jsonDataURL (p : palette.Palette) : String :=
  "data:application/json;base64," + b64OfBytes (palette.ToJSON p)

-- Server pages link the endpoints; the wasm build hands out the files
-- directly as data: URLs, since there is no server behind it.
let downloadLinks (m : Model) : String :=
  if m.Embed
    then ("<a class=\"dl pdf\" download=\"" + FileStem m + ".pdf\" href=\"" + pdfDataURL m.Pal + "\">Download PDF</a>" +
      "<a class=\"dl json\" download=\"" + FileStem m + ".json\" href=\"" + jsonDataURL m.Pal + "\">Download JSON</a>")
    else ("<a class=\"dl pdf\" href=\"palette.pdf?" + m.QS + "\">Download PDF</a>" +
      "<a class=\"dl json\" href=\"palette.json?" + m.QS + "\">Download JSON</a>")

let ResultHTML (m : Model) : String :=
  "<div class=\"result-head\"><h2 id=\"result-heading\" tabindex=\"-1\">" + m.Pal.Name + "</h2>" +
    "<button id=\"preview-toggle\" type=\"button\" class=\"ghost\" aria-expanded=\"false\" aria-controls=\"palette-preview\" hidden>Palette preview</button></div>" + palettePreview m.Pal +
    "<nav class=\"downloads\" aria-label=\"Download palette\">" + downloadLinks m +
    "</nav>" +
    "<p class=\"basis\">" + m.Pal.Basis + "</p>" +
    categorySection "Primary" "Your product's voice. Use these for primary actions, links, navigation, icons - the splashes of color that determine the overall look." m.Pal.Primary +
    (if len m.Pal.Secondary > 0 then categorySection "Secondary" palette.DescSecondary m.Pal.Secondary else "") +
    categorySection "Neutrals" "The workhorse. Most of your UI is this: text, backgrounds, panels, borders, secondary buttons." m.Pal.Neutrals +
    categorySection "Supporting" "The seasoning, used sparingly: success, warning and danger states, plus accents that keep the primary color special." m.Pal.Supporting +
    contextSection m.Pal +
    jsonSection m

-- Live previews avoid generating a PDF on every pointer movement. The static
-- browser target creates its data URL only when the download is requested.
let LiveResultHTML (m : Model) : String := do {
  let live := { m with Embed = false };
  ResultHTML live
}

let ExportDataURL (m : Model) (pdf : Bool) : String :=
  if pdf then pdfDataURL m.Pal else jsonDataURL m.Pal

-- The goforge.dev project metadata, worn the way the other tool pages
-- wear it: a version pill, the install command, and the standard links.
let projectMeta () : String :=
  "<div class=\"meta\">" +
    "<span class=\"pill\"><span class=\"dot\"></span>" + Version + "</span>" +
    "<code class=\"install\"><span class=\"prompt\">$</span> go install goforge.dev/palettegen@latest</code>" +
    "<nav class=\"meta-links\" aria-label=\"Project links\">" +
    "<a href=\"https://github.com/brain-fuel/palettegen\">Source repository</a>" +
    "<a href=\"https://pkg.go.dev/goforge.dev/palettegen\">pkg.go.dev</a>" +
    "<a href=\"https://goforge.dev/\">goforge.dev</a>" +
    "</nav></div>"

let htmlAttrs (m : Model) : String :=
  if m.Theme == "" then "" else " data-theme=\"" + m.Theme + "\""

let headAssets (m : Model) : String :=
  if m.Embed
    then "<style>\n" + EmbeddedCSS m.Pal + "\n</style><style id=\"palette-theme\"></style>\n"
    else ("<link rel=\"stylesheet\" href=\"style.css\">\n" +
      "<style id=\"palette-theme\">\n" + ThemeCSS m.Pal + "\n</style>\n" +
      "<script src=\"wasm_exec.js\" defer></script><script src=\"browser.js\" defer></script>\n")

let PageHead (m : Model) : String :=
    "<meta charset=\"utf-8\">\n" +
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" +
    "<title>PaletteGen - complete UI color palettes</title>\n" +
    "<link rel=\"icon\" href=\"data:,\">" +
    headAssets m

let PageBody (m : Model) : String :=
    "<main>\n" +
    "<header class=\"hero\">" +
    "<div class=\"hero-top\"><h1>PaletteGen</h1>" + themeToggle m + "</div>" +
    "</header>\n" +
    "<nav id=\"editor-history-bar\" class=\"editor-history-bar\" aria-label=\"Live palette controls\" hidden>" +
    "<div class=\"recovery-actions\">" +
    "<button id=\"undo-palette\" type=\"button\" class=\"ghost\" disabled>Undo</button><button id=\"redo-palette\" type=\"button\" class=\"ghost\" disabled>Redo</button>" +
    "<button id=\"open-history\" type=\"button\" class=\"ghost\" aria-expanded=\"false\" aria-controls=\"session-history\">History</button></div>" +
    "<div class=\"workspace-actions\"><button id=\"view-editor\" type=\"button\" class=\"ghost\" aria-label=\"Edit colors: return to picture and manual colors\" aria-controls=\"image-panel\">Edit<span class=\"toolbar-wide-label\"> colors</span></button>" +
    "<button id=\"view-palette\" type=\"button\" class=\"primary\" aria-label=\"See palette\" aria-controls=\"palette-results\"><span class=\"toolbar-wide-label\">See </span>palette</button>" +
    "<button id=\"view-examples\" type=\"button\" class=\"ghost\" aria-label=\"See examples\" aria-controls=\"examples\"><span class=\"toolbar-wide-label\">Examples</span><span class=\"toolbar-short-label\">Demos</span></button></div></nav>" +
    "<div id=\"model-note\" role=\"status\">" + NoteHTML m + "</div>" +
    controls m +
    "<div id=\"palette-results\" role=\"region\" aria-label=\"Your palette\">" + ResultHTML m + "</div><p id=\"result-status\" class=\"sr-only\" aria-live=\"polite\"></p>" +
    "\n<footer><details class=\"project-info\"><summary>About PaletteGen</summary>" + projectMeta () +
    "<p>Palettes and method from <em>Refactoring UI: Color Palettes</em> and <em>Refactoring UI</em> (Adam Wathan &amp; Steve Schoger). " +
    "Written in goml on the <a href=\"https://goforge.dev\">goforge</a> toolchain. " +
    "<a href=\"https://github.com/brain-fuel/palettegen/blob/main/LICENSE\">MIT licensed</a>.</p></details></footer>\n" +
    "</main>\n<div id=\"selection-notice\" class=\"selection-notice\" hidden aria-hidden=\"true\"></div>" +
    "<p id=\"selection-announcement\" class=\"sr-only\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></p>"

let RenderPage (m : Model) : String :=
  "<!doctype html>\n<html lang=\"en\"" + htmlAttrs m + ">\n<head>\n" + PageHead m + "</head><body>" + PageBody m + "</body></html>\n"
