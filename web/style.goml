  ".color-row { display: flex; flex-wrap: wrap; align-items: end; gap: 13px; }",
  ".field { min-width: 0; }",
  ".hex-field { flex: 1; min-width: 130px; }",
  ".field input[type=text], .field input[type=url], .field select { width: 100%; min-width: 0; font: 16px/1.4 'Atkinson Hyperlegible', sans-serif; }",
  ".field input[type=url] { height: 44px; border: 1px solid var(--line-soft); padding: 0 13px; border-radius: 8px; color: var(--ink); background: var(--field); }",
  ".optional { font: 400 12px 'Atkinson Hyperlegible', sans-serif; color: var(--ink-soft); margin-left: 5px; }",
  ".secondary-controls { margin: 0; min-width: 0; }",
  ".secondary-controls[open] { flex: 1; }",
  ".secondary-section { display: flex; align-items: flex-start; gap: 8px; }",
  ".secondary-collapsed-remove { flex: 0 0 auto; min-width: 44px; }",
  ".secondary-summary-color { display: inline-block; width: 22px; height: 22px; margin: 0 4px; vertical-align: middle; border-radius: 5px; box-shadow: inset 0 0 0 1px var(--line-soft); }",
  "#secondary-summary-hex { font: 12px 'Atkinson Hyperlegible Mono', monospace; }",
  "summary { cursor: pointer; min-height: 44px; padding: 10px 0; font-weight: 700; color: var(--accent-ink); }",
  ".secondary-controls[open] summary { margin-bottom: 8px; }",
  ".field-help { color: var(--ink-mid); font-size: 14px; margin: 8px 0 13px; overflow-wrap: anywhere; }",
  ".text-button { background: transparent; color: var(--accent-ink); padding: 0 8px; height: auto; min-height: 44px; text-decoration: underline; text-underline-offset: 3px; }",
  ".image-panel { border-bottom: 1px solid var(--line); margin: 0 0 21px; padding: 0 0 21px; }",
  ".drop-zone { padding: 21px; border-radius: 10px; background: var(--bg); box-shadow: inset 0 0 0 1px var(--line-soft); }",
  ".drop-zone.dragging { box-shadow: inset 0 0 0 3px var(--accent); }",
  "input[type=file] { width: 100%; min-height: 44px; font: 16px 'Atkinson Hyperlegible', sans-serif; color: var(--ink); }",
  "input[type=file]::file-selector-button { min-height: 44px; margin-right: 13px; padding: 0 13px; border: 1px solid var(--line-soft); border-radius: 8px; background: var(--card); color: var(--accent-ink); font: inherit; cursor: pointer; }",
  ".image-url-form { display: flex; gap: 13px; align-items: end; margin-top: 21px; }",
  ".image-url-form .field { flex: 1; }",
  ".clipboard-row { display: flex; align-items: center; flex-wrap: wrap; gap: 13px; margin-top: 21px; }",
  ".clipboard-row .field-help { margin: 0; flex: 1; min-width: 160px; }",
  ".selection-notice { position: fixed; z-index: 20; top: calc(env(safe-area-inset-top, 0px) + 16px); left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 13px; width: max-content; max-width: calc(100% - 26px); padding: 13px 16px; border-radius: 10px; background: var(--card); color: var(--ink); box-shadow: var(--shadow-soft), 0 0 0 1px var(--line-soft); pointer-events: none; font-size: 16px; }",
  ".notice-swatch { width: 28px; height: 28px; flex: 0 0 28px; border-radius: 5px; box-shadow: inset 0 0 0 1px rgba(0,0,0,.2); }",
  ".picture-frame { position: relative; padding: 0; background: #FFFFFF; border-radius: 10px; box-shadow: inset 0 0 0 1px rgba(0,0,0,.15); overflow: hidden; }",
  "#picture { display: block; position: absolute; left: 0; top: 0; transform-origin: 0 0; max-width: none; max-height: none; margin: 0; cursor: crosshair; background: #FFFFFF; }",
  "#picture-viewport { position: relative; height: 100%; min-width: 0; overflow: hidden; touch-action: none; }",
  ".image-panel.has-picture #drop-zone { display: grid; grid-template-columns: minmax(0, 1fr) 44px; height: 300px; gap: 8px; }",
  ".picture-zoom { display: flex; flex-direction: column; justify-content: center; gap: 0; background: var(--card); }",
  ".picture-zoom button { width: 44px; min-height: 44px; padding: 0; border-radius: 0; box-shadow: none; color: var(--ink); font-size: 18px; }",
  ".picture-zoom #picture-fit { font-size: 13px; }",
  ".picture-command-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }",
  ".picture-command-row button { min-height: 44px; padding: 0; font-size: 14px; }",
  ".picture-marker { position: absolute; width: 18px; height: 18px; border: 2px solid #FFFFFF; border-radius: 50%; box-shadow: 0 0 0 2px #102A43; transform: translate(-50%, -50%); pointer-events: none; }",
  ".sample-row { display: flex; align-items: center; flex-wrap: wrap; gap: 13px; margin: 8px 0 13px; }",
  "#magnifier { width: 132px; height: 132px; border-radius: 6px; background: white; box-shadow: 0 0 0 1px var(--line-soft); image-rendering: pixelated; cursor: crosshair; touch-action: pan-y; }",
  ".sample-actions { min-width: 0; flex: 1; }",
  "#sample-hex { display: block; font-size: 18px; margin-bottom: 8px; }",
  ".assign-actions { display: flex; flex-wrap: wrap; gap: 8px; }",
  "button:disabled { opacity: .55; cursor: default; }",
  ".suggestion-heading { font-size: 16px; margin: 21px 0 8px; }",
  ".picture-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 13px; margin-top: 21px; }",
  ".image-suggestions { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; }",
  ".suggestion { height: auto; min-height: 48px; display: flex; align-items: center; gap: 8px; padding: 8px; background: var(--card); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line-soft); font-size: 13px; }",
  ".suggestion[aria-pressed=true] { box-shadow: inset 0 0 0 3px var(--accent-ink); }",
  ".suggestion-chip { width: 28px; height: 28px; flex: 0 0 28px; border-radius: 5px; box-shadow: inset 0 0 0 1px rgba(0,0,0,.15); }",
  "a:focus-visible, summary:focus-visible, button:focus-visible, canvas:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid var(--accent-ink); outline-offset: 3px; }",
  ".theme-toggle a { min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }",
  ".meta, .result-head, .downloads, .demo-actions, .nav-demo { min-width: 0; flex-wrap: wrap; }",
  ".result-head h2, .basis, .scale-head h4 { overflow-wrap: anywhere; }",
  ".scale-head { flex-wrap: wrap; gap: 5px; }",
  ".meta code { max-width: 100%; overflow-x: auto; }",
  ".context-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }",
  "code, pre, kbd, samp, .sw-hex, .sw-hsl, .json-view code, .meta code, #sample-hex, .suggestion, .hex-field input[type=text] { font-family: 'Atkinson Hyperlegible Mono', monospace; }",
  ".sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }",
  "header.hero { margin-bottom: 8px; }",
  ".hero-top { align-items: center; gap: 13px; }",
  ".hero-top h1 { margin: 0; }",
  ".editor-heading { font-size: 20px; margin: 0 0 8px; }",
  ".manual-editor .gen { max-width: 620px; }",
  ".manual-editor .gen > .primary { align-self: flex-start; min-width: 200px; }",
  ".hex-field { max-width: 260px; }",
  ".clipboard-row { margin-top: 13px; }",
  ".image-url-options { margin-top: 8px; }",
  ".image-url-options .image-url-form { margin-top: 8px; }",
  ".curated-options { max-width: 620px; margin-top: 13px; }",
  "form.curated { border: 0; padding: 0; }",
  ".project-info .meta { margin: 13px 0; }",
  ".feedback { display: grid; gap: 3px; padding: 13px; border-left: 3px solid var(--line-soft); border-radius: 6px; background: var(--field); color: var(--ink-mid); font-size: 14px; }",
  ".feedback:empty { display: none; }",
  ".feedback-label { font-weight: 700; font-size: 13px; }",
  ".feedback[data-tone=success] { background: var(--success-bg); color: var(--success-ink); border-color: var(--success-line); }",
  ".feedback[data-tone=warning] { background: var(--warning-bg); color: var(--warning-ink); border-color: var(--warning-line); }",
  ".feedback[data-tone=error] { background: var(--error-bg); color: var(--error-ink); border-color: var(--error-line); }",
  ".feedback[data-tone=loading] { background: var(--info-bg); color: var(--info-ink); border-color: var(--info-line); }",
  ".selection-notice { background: var(--success-bg); color: var(--success-ink); box-shadow: var(--shadow-soft), 0 0 0 1px var(--success-line); }",
  ".precision-sample { flex: 0 0 132px; }",
  ".precision-sample h4 { margin: 0 0 8px; font-size: 15px; }",
  ".precision-sample .field-help { max-width: 132px; margin-bottom: 0; font-size: 12px; }",
  ".sample-row { align-items: flex-start; }",
  ".sample-actions { padding-top: 0; }",
  ".secondary-role-actions { display: flex; flex-direction: column; gap: 4px; }",
  ".secondary-role-actions .text-button { font-size: 13px; padding: 0 4px; }",
  "#magnifier[aria-disabled=true] { cursor: default; }",
  "#magnifier { touch-action: none; scroll-margin-top: 190px; }",
  "#magnifier[aria-disabled=true] { touch-action: pan-y; }",
  "#picture { scroll-margin-top: 190px; }",
  ".image-panel.has-picture #drop-zone { padding: 0; background: #FFFFFF; }",
  ".image-panel:not(.has-picture) #drop-zone { padding: 13px; background: var(--bg); }",
  ".editor-history-bar { display: flex; gap: 13px; align-items: center; position: sticky; top: 0; z-index: 8; background: var(--card); padding: calc(4px + env(safe-area-inset-top, 0px)) 0 4px; margin-bottom: 8px; }",
  ".recovery-actions, .workspace-actions { display: flex; gap: 6px; align-items: center; }",
  ".workspace-actions { margin-left: auto; }",
  ".editor-history-bar button { flex-shrink: 0; min-width: 44px; padding: 0 8px; font-size: 14px; white-space: nowrap; }",
  "#picture-title { scroll-margin-top: calc(var(--workspace-bar-height) + 28px); }",
  ".session-history { background: var(--bg); padding: 13px; margin-bottom: 21px; border-radius: 8px; max-height: 55vh; overflow: auto; }",
  "#session-history { scroll-margin-top: calc(var(--workspace-bar-height) + 28px); }",
  ".history-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }",
  ".session-history h3 { font-size: 16px; margin: 13px 0 8px; }",
  ".palette-history, .color-history { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 8px; }",
  ".history-palette, .history-color { display: flex; align-items: center; gap: 8px; min-height: 44px; height: auto; text-align: left; padding: 8px; background: var(--card); color: var(--ink); font-size: 13px; box-shadow: inset 0 0 0 1px var(--line-soft); overflow-wrap: anywhere; }",
  ".history-palette[aria-pressed=true] { box-shadow: inset 0 0 0 2px var(--accent-ink); }",
  ".history-swatch { width: 22px; height: 28px; flex: 0 0 22px; border-radius: 4px; box-shadow: inset 0 0 0 1px rgba(0,0,0,.2); }",
  ".history-role-field { margin-bottom: 8px; max-width: 220px; }",
  ".assign-actions button[aria-pressed=true] { background: var(--accent); color: var(--accent-text); }",
  "#sampling-role { margin: 0 0 4px; font-size: 12px; line-height: 1.2; }",
  "#sample-hex { margin: 0 0 4px; line-height: 1.3; }",
  ".assign-actions { gap: 4px; }",
  "#result-heading { scroll-margin-top: calc(var(--workspace-bar-height) + 28px); }",
  "#examples-heading, .scale-head h4 { scroll-margin-top: calc(var(--workspace-bar-height) + var(--download-bar-height) + 28px); }",
  ".toolbar-short-label { display: none; }",
  ".palette-preview { display: none; position: relative; background: var(--card); padding: 13px; margin-bottom: 13px; border-radius: 8px; box-shadow: var(--shadow-soft); }",
  ".palette-preview.is-open { display: block; }",
  ".preview-range { display: flex; justify-content: space-between; color: var(--ink-mid); font: 11px 'Atkinson Hyperlegible Mono', monospace; margin-bottom: 4px; }",
  ".preview-list { display: grid; gap: 4px; max-height: 260px; overflow-y: auto; overscroll-behavior: contain; }",
  ".preview-scale { display: flex; align-items: center; gap: 13px; min-height: 44px; min-width: 44px; padding: 0 2px; color: var(--ink); text-decoration: none; }",
  ".preview-scale:focus-visible { outline: 3px solid var(--focus); outline-offset: -3px; border-radius: 5px; }",
  ".preview-strip { display: block; flex: 0 0 80px; height: 24px; border-radius: 4px; box-shadow: inset 0 0 0 1px var(--line-soft); }",
  ".preview-name { font-size: 13px; line-height: 1.3; overflow-wrap: anywhere; }",
  ".preview-hover-label { display: none; }",
  "@media (min-width: 1280px) {",
  "  #preview-toggle { display: none; }",
  "  .palette-preview, .palette-preview.is-open { display: block; position: fixed; right: 16px; top: calc(var(--workspace-bar-height) + 96px); z-index: 6; width: 64px; padding: 8px; margin: 0; }",
  "  .preview-list { max-height: calc(100svh - var(--workspace-bar-height) - 148px); gap: 2px; scrollbar-width: thin; }",
  "  .preview-scale { padding: 0; }",
  "  .preview-strip { flex-basis: 100%; }",
  "  .preview-name { display: none; }",
  "  .preview-hover-label { display: block; position: absolute; top: 0; right: calc(100% + 8px); width: max-content; max-width: 240px; margin: 0; padding: 8px 13px; border-radius: 8px; background: var(--card); color: var(--ink); box-shadow: var(--shadow-soft); font-size: 13px; }",
  "}",
  "@media (max-width: 760px) {",
  "  .editor-forms, .context-grid { grid-template-columns: minmax(0, 1fr); gap: 21px; }",
  "  .manual-editor .gen > .primary { align-self: stretch; }",
  "  form.curated { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); padding-top: 21px; }",
  "  .image-panel.has-picture #drop-zone { height: clamp(132px, calc(100svh - 428px), 260px); }",
  "}",
  "@media (max-width: 480px) {",
  "  .editor-history-bar { gap: 4px; }",
  "  .recovery-actions, .workspace-actions { gap: 2px; }",
  "  .editor-history-bar button { padding: 0 4px; font-size: 13px; }",
  "  .toolbar-wide-label { display: none; }",
  "  .toolbar-short-label { display: inline; }",
  "  #secondary-summary-hex { display: none; }",
  "  #view-palette { text-transform: capitalize; }",
  "  main { padding: 13px 13px 34px; }",
  "  .hero-top { gap: 8px; flex-wrap: nowrap; }",
  "  .hero-top h1 { font-size: clamp(18px, 5.5vw, 24px); white-space: nowrap; }",
  "  .theme-toggle { gap: 0; padding: 0; font-size: 12px; }",
  "  .theme-toggle a { padding: 0; }",
  "  .controls { padding: 12px; }",
  "  .scale-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }",
  "  .sw { min-height: 76px; font-size: 13px; padding: 13px; }",
  "  .image-url-form { flex-direction: column; align-items: stretch; }",
  "  .sample-row { gap: 13px; }",
  "  .sample-actions { flex-basis: 0; min-width: 0; }",
  "  .assign-actions button { padding: 0 6px; font-size: 14px; height: auto; min-height: 44px; }",
  "  .assign-actions { flex-direction: column; align-items: stretch; }",
  "  .secondary-role-actions { display: contents; }",
  "  .picture-footer .primary { width: 100%; }",
  "  .drop-zone { padding: 13px; }",
  "  .downloads { width: 100%; }",
  "  .downloads a { flex: 1; text-align: center; padding: 10px; }",
  "}"
]

-- Stylesheet is what the server serves at /style.css: font faces (by URL)
-- plus structural rules. Color tokens arrive per page via ThemeCSS.
let Stylesheet := strings.Join (fontFace false) "\n" + "\n" + strings.Join cssRows "\n"

-- EmbeddedCSS is the whole thing inline - fonts as data: URLs, structure,
-- and the palette's tokens - for the WebAssembly build, which has no
-- server to fetch assets from.
let EmbeddedCSS (p : palette.Palette) : String :=
  strings.Join (fontFace true) "\n" + "\n" + strings.Join cssRows "\n" + "\n" + ThemeCSS p
