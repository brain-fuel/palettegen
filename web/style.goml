module web

-- The app's stylesheet. Its chrome is Palette 1 from the book (cyan primary,
-- blue-grey neutrals) - the tool practices what it preaches. Proportions sit
-- on a Fibonacci-ish scale (8/13/21/34/55) and a golden-ratio type ramp
-- (16 / 26 / 42); depth comes from soft light, not hard borders.
--
-- Theming: the chrome's color tokens are computed from the SELECTED palette
-- (its neutral scale carries surfaces and text, its primary scale carries
-- actions and accents), in a light and a dark variant. With no explicit
-- choice the OS preference wins (prefers-color-scheme); an explicit
-- ?t=light / ?t=dark lands as data-theme on <html> and overrides it.
-- /style.css holds only structural rules; every page emits its own token
-- block via ThemeCSS, so the whole site wears the palette it is showing.
-- The swatches and in-context demos keep their inline palette colors in
-- both schemes - they are the content, not the chrome.

import "fmt"
import "math"
import "strings"
import "goforge.dev/palettegen/palette"

let rgbaOf (sh : palette.Shade) (alpha : String) : String := do {
  let c := palette.RGBOf sh;
  fmt.Sprintf "rgba(%d,%d,%d,%s)" c.R c.G c.B alpha
}

let inkOn (sh : palette.Shade) : String :=
  if palette.LumaOf sh > 150.0 then "#102A43" else "#FFFFFF"

let linearChannel (channel : Int) : Float64 := do {
  let value := Float64 channel / 255.0;
  if value <= 0.04045 then value / 12.92 else math.Pow ((value + 0.055) / 1.055) 2.4
}

let relativeLight (shade : palette.Shade) : Float64 := do {
  let rgb := palette.RGBOf shade;
  0.2126 * linearChannel rgb.R + 0.7152 * linearChannel rgb.G + 0.0722 * linearChannel rgb.B
}

let inkContrast (first : palette.Shade) (second : palette.Shade) : Float64 := do {
  let a := relativeLight first;
  let b := relativeLight second;
  (math.Max a b + 0.05) / (math.Min a b + 0.05)
}

-- Some yellow scales have a bright darkest shade. Use neutral control ink
-- when the brand shade would disappear against the interface's surface.
let accentInkFor (shade : palette.Shade) (surface : palette.Shade) (fallback : palette.Shade) : String :=
  if inkContrast shade surface >= 4.5 then shade.Hex else fallback.Hex

let lightTokensFor (p : palette.Palette) : Slice String := do {
  let pr := p.Primary[0].Shades;
  let nu := p.Neutrals[0].Shades;
  let ink := accentInkFor pr[0] nu[9] nu[0];
  [
    "  --bg: " + nu[9].Hex + "; --card: #FFFFFF; --field: #FFFFFF;",
    "  --ink: " + nu[0].Hex + "; --ink-mid: " + nu[3].Hex + "; --ink-soft: " + nu[4].Hex + "; --faint: " + nu[5].Hex + ";",
    "  --line: " + nu[8].Hex + "; --line-soft: " + nu[7].Hex + ";",
    "  --accent: " + pr[2].Hex + "; --accent-hover: " + pr[3].Hex + "; --accent-text: " + inkOn pr[2] + ";",
    "  --accent-ink: " + ink + "; --accent-wash: " + pr[9].Hex + "; --focus: " + ink + ";",
    "  --note-bg: #FFFBEA; --note-ink: #513C06; --note-line: #F7D070;",
    "  --success-bg: #E3F9E5; --success-ink: #014B04; --success-line: #57AE5B;",
    "  --warning-bg: #FFFBEA; --warning-ink: #513C06; --warning-line: #C99A2E;",
    "  --error-bg: #FFEEEE; --error-ink: #610316; --error-line: #D64545;",
    "  --info-bg: #E6F6FF; --info-ink: #003E6B; --info-line: #408AB0;",
    "  --shadow-soft: 0 1px 3px " + rgbaOf nu[0] ".12" + ", 0 8px 24px " + rgbaOf nu[0] ".08" + ";"
  ]
}

let darkTokensFor (p : palette.Palette) : Slice String := do {
  let pr := p.Primary[0].Shades;
  let nu := p.Neutrals[0].Shades;
  let ink := accentInkFor pr[8] nu[1] nu[9];
  [
    "  --bg: " + nu[0].Hex + "; --card: " + nu[1].Hex + "; --field: " + nu[2].Hex + ";",
    "  --ink: " + nu[9].Hex + "; --ink-mid: " + nu[7].Hex + "; --ink-soft: " + nu[6].Hex + "; --faint: " + nu[5].Hex + ";",
    "  --line: " + nu[2].Hex + "; --line-soft: " + nu[3].Hex + ";",
    "  --accent: " + pr[5].Hex + "; --accent-hover: " + pr[6].Hex + "; --accent-text: " + inkOn pr[5] + ";",
    "  --accent-ink: " + ink + "; --accent-wash: " + rgbaOf pr[6] ".14" + "; --focus: " + ink + ";",
    "  --note-bg: #3D3106; --note-ink: #F8E3A3; --note-line: #C99A2E;",
    "  --success-bg: #0B2E13; --success-ink: #ABEEB3; --success-line: #57AE5B;",
    "  --warning-bg: #3D3106; --warning-ink: #F8E3A3; --warning-line: #C99A2E;",
    "  --error-bg: #3E0B0B; --error-ink: #FFBDBD; --error-line: #D64545;",
    "  --info-bg: #102A43; --info-ink: #B3ECFF; --info-line: #408AB0;",
    "  --shadow-soft: 0 1px 3px rgba(0,0,0,.4), 0 8px 24px rgba(0,0,0,.3);"
  ]
}

let tokenBlock (selector : String) (rows : Slice String) (extra : String) : Slice String := do {
  let mut out := make (Slice String) 0;
  out := append out (selector + " {");
  for _, row in rows do { out := append out row };
  if extra != "" then do { out := append out ("  " + extra) } else ();
  append out "}"
}

-- A palette that cannot carry the chrome falls back to Palette 1.
let chromePalette (p : palette.Palette) : palette.Palette := do {
  if len p.Primary > 0 && len p.Neutrals > 0
    && len p.Primary[0].Shades == 10 && len p.Neutrals[0].Shades == 10
    then p
    else palette.FromCurated 1
}

let themeRowsFor (p0 : palette.Palette) : Slice String := do {
  let p := chromePalette p0;
  let lightTokens := lightTokensFor p;
  let darkTokens := darkTokensFor p;
  let mut out := make (Slice String) 0;
  for _, row in tokenBlock ":root" lightTokens "color-scheme: light dark;" do { out := append out row };
  out := append out "@media (prefers-color-scheme: dark) {";
  for _, row in tokenBlock "  :root:not([data-theme=light])" darkTokens "" do { out := append out ("  " + row) };
  out := append out "}";
  for _, row in tokenBlock ":root[data-theme=light]" lightTokens "color-scheme: light;" do { out := append out row };
  for _, row in tokenBlock ":root[data-theme=dark]" darkTokens "color-scheme: dark;" do { out := append out row };
  out
}

-- The per-page token block: the whole site wears the selected palette.
let ThemeCSS (p : palette.Palette) : String := strings.Join (themeRowsFor p) "\n"

-- One @font-face rule; embedded builds inline the woff2 as a data: URL,
-- the server build points at /fonts/ (relative, so it works under any base).
let fontFaceRow (family : String) (style : String) (weight : String) (src : String) : String :=
  "@font-face { font-family: '" + family + "'; font-style: " + style + "; font-weight: " + weight +
    "; font-display: swap; src: url(" + src + ") format('woff2'); }"

let fontSrc (embed : Bool) (b64 : String) (file : String) : String :=
  if embed then "data:font/woff2;base64," + b64 else "'fonts/" + file + "'"

let fontFace (embed : Bool) : Slice String := [
  "/* Self-hosted fonts, embedded in the binary (SIL OFL 1.1). */",
  fontFaceRow "Overpass" "normal" "700" (fontSrc embed overpass700B64 "overpass-700.woff2"),
  fontFaceRow "Atkinson Hyperlegible" "normal" "400" (fontSrc embed atkinson400B64 "atkinson-400.woff2"),
  fontFaceRow "Atkinson Hyperlegible" "normal" "700" (fontSrc embed atkinson700B64 "atkinson-700.woff2"),
  fontFaceRow "Atkinson Hyperlegible" "italic" "400" (fontSrc embed atkinson400iB64 "atkinson-400-italic.woff2"),
  fontFaceRow "Atkinson Hyperlegible Mono" "normal" "400" (fontSrc embed atkinsonMono400B64 "atkinson-mono-400.woff2"),
  fontFaceRow "Atkinson Hyperlegible Mono" "normal" "700" (fontSrc embed atkinsonMono700B64 "atkinson-mono-700.woff2"),
  ""
]

let cssRows : Slice String := [
  "* { box-sizing: border-box; }",
  "[hidden] { display: none !important; }",
  "body {",
  "  --workspace-bar-height: 0px;",
  "  --download-bar-height: 70px;",
  "  margin: 0; background: var(--bg); color: var(--ink);",
  "  font: 16px/1.55 'Atkinson Hyperlegible', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;",
  "}",
  "h1, h2, h3, h4 {",
  "  font-family: 'Overpass', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;",
  "  font-weight: 700;",
  "}",
  "main { max-width: 1060px; margin: 0 auto; padding: 34px 21px 55px; }",
  "header.hero { margin-bottom: 34px; }",
  ".hero-top { display: flex; align-items: baseline; justify-content: space-between; gap: 21px; flex-wrap: wrap; }",
  "h1 { font-size: 42px; line-height: 1.15; margin: 0 0 13px; letter-spacing: -0.01em; }",
  "h1 .fleck { color: var(--accent-ink); }",
  "h2 { font-size: 26px; margin: 0 0 5px; }",
  "h3 { font-size: 20px; margin: 0; }",
  ".caption { color: var(--ink-soft); margin: 0 0 21px; max-width: 72ch; }",
  ".note {",
  "  background: var(--note-bg); color: var(--note-ink); border-left: 4px solid var(--note-line);",
  "  padding: 13px 21px; border-radius: 8px; margin: 0 0 21px;",
  "}",
  "",
  "/* ---- project metadata, goforge.dev-style ---- */",
  ".meta { display: flex; flex-wrap: wrap; align-items: center; gap: 13px; margin-top: 21px; font-size: 13px; }",
  ".pill {",
  "  display: inline-flex; align-items: center; gap: 6px; background: var(--card);",
  "  border-radius: 999px; padding: 4px 12px; font-weight: 700; color: var(--ink-mid);",
  "  box-shadow: var(--shadow-soft);",
  "}",
  ".pill .dot { width: 6px; height: 6px; border-radius: 999px; background: var(--accent); }",
  "code.install {",
  "  background: var(--card); border-radius: 8px; padding: 6px 13px;",
  "  font-family: 'Atkinson Hyperlegible Mono', monospace; font-size: 12.5px;",
  "  color: var(--ink); box-shadow: var(--shadow-soft); user-select: all;",
  "}",
  "code.install .prompt { color: var(--accent-ink); margin-right: 6px; user-select: none; }",
  ".meta-links { display: flex; gap: 13px; }",
  ".meta-links a { color: var(--accent-ink); font-weight: 600; text-decoration: none; }",
  ".meta-links a:hover { text-decoration: underline; }",
  "",
  "/* ---- scheme toggle: quiet, in the header ---- */",
  ".theme-toggle { display: flex; gap: 3px; font-size: 13px; background: var(--card); border-radius: 999px; padding: 3px; box-shadow: var(--shadow-soft); }",
  ".theme-toggle a { color: var(--ink-soft); text-decoration: none; padding: 3px 13px; border-radius: 999px; }",
  ".theme-toggle a:hover { color: var(--accent-ink); }",
  ".theme-toggle a.on { background: var(--accent); color: var(--accent-text); font-weight: 700; }",
  "",
  "/* ---- controls: one clear primary action ---- */",
  ".controls {",
  "  display: flex; flex-wrap: wrap; gap: 21px; align-items: stretch;",
  "  background: var(--card); border-radius: 13px; padding: 21px;",
  "  box-shadow: var(--shadow-soft); margin-bottom: 55px;",
  "}",
  "form.gen, form.curated { display: flex; flex-wrap: wrap; gap: 13px; align-items: flex-end; }",
  "form.curated { border-left: 1px solid var(--line); padding-left: 21px; }",
  ".field { display: flex; flex-direction: column; gap: 5px; font-size: 13px; color: var(--ink-mid); font-weight: 600; }",
  ".field input[type=color] {",
  "  width: 76px; height: 44px; padding: 2px; border: 1px solid var(--line-soft);",
  "  border-radius: 8px; background: var(--field); cursor: pointer;",
  "}",
  ".field input[type=text], .field select {",
  "  height: 44px; padding: 0 13px; border: 1px solid var(--line-soft); border-radius: 8px;",
  "  font: inherit; color: var(--ink); background: var(--field); min-width: 150px;",
  "}",
  ".field input:focus, .field select:focus, button:focus, .theme-toggle a:focus { outline: 3px solid var(--focus); border-color: var(--accent-hover); }",
  "button {",
  "  height: 44px; padding: 0 21px; border: 0; border-radius: 8px; font: inherit;",
  "  font-weight: 700; cursor: pointer;",
  "}",
