module main

-- Palette Forge: a web app that gives out complete UI color palettes.
-- Palette state lives in the URL (?c=hex&s=hex or ?p=id). Server-rendered
-- GET forms work independently; the embedded goml/Wasm target adds image
-- sampling and updates in place. The shared renderer lives in web/.

import "fmt"
import "io"
import "net/http"
import "os"
import "strings"
import "goforge.dev/palettegen/palette"
import "goforge.dev/palettegen/web"
import "goforge.dev/palettegen/browserassets"

let sink (n : Int) (e : Error) : Unit := ()

let emit (w : http.ResponseWriter) (s : String) : Unit := do {
  let n, err := io.WriteString w s;
  sink n err
}

let emitBytes (w : http.ResponseWriter) (bs : Slice Byte) : Unit := do {
  let n, err := w.Write bs;
  sink n err
}

let modelFrom (r : Ptr http.Request) : web.Model :=
  web.ModelFromValues ((r.URL).Query ()) false

let handlePage (w : http.ResponseWriter) (r : Ptr http.Request) : Unit := do {
  if (r.URL).Path != "/" then http.NotFound w r else do {
    let m := modelFrom r;
    let h := w.Header ();
    h.Set "Content-Type" "text/html; charset=utf-8";
    emit w (web.RenderPage m)
  }
}

let handleCSS (w : http.ResponseWriter) (r : Ptr http.Request) : Unit := do {
  let h := w.Header ();
  h.Set "Content-Type" "text/css; charset=utf-8";
  emit w web.Stylesheet
}

let handleFont (w : http.ResponseWriter) (r : Ptr http.Request) : Unit := do {
  let bs := web.FontFor ((r.URL).Path);
  if len bs == 0 then http.NotFound w r else do {
    let h := w.Header ();
    h.Set "Content-Type" "font/woff2";
    h.Set "Cache-Control" "public, max-age=31536000, immutable";
    emitBytes w bs
  }
}

let handleBrowser (w : http.ResponseWriter) (r : Ptr http.Request) : Unit := do {
  let path := (r.URL).Path;
  let data := browserassets.Asset path;
  if len data == 0 then http.NotFound w r else do {
    let headers := w.Header ();
    headers.Set "Content-Type" (if path == "/app.wasm" then "application/wasm" else if path == "/app.wasm.gz" then "application/gzip" else "text/javascript; charset=utf-8");
    headers.Set "Cache-Control" "no-cache";
    emitBytes w data
  }
}

let handleJSON (w : http.ResponseWriter) (r : Ptr http.Request) : Unit := do {
  let m := modelFrom r;
  let h := w.Header ();
  h.Set "Content-Type" "application/json";
  h.Set "Content-Disposition" ("attachment; filename=\"" + web.FileStem m + ".json\"");
  emitBytes w (palette.ToJSON m.Pal)
}

let handlePDF (w : http.ResponseWriter) (r : Ptr http.Request) : Unit := do {
  let m := modelFrom r;
  let h := w.Header ();
  h.Set "Content-Type" "application/pdf";
  h.Set "Content-Disposition" ("attachment; filename=\"" + web.FileStem m + ".pdf\"");
  let err := palette.WritePDF w m.Pal;
  if err != nil then http.Error w "PDF generation failed" 500 else ()
}

let portFrom (env : String) : String :=
  if strings.TrimSpace env == "" then "8383" else env

let main () : Unit := do {
  if len os.Args > 1 && os.Args[1] == "check" then do {
    os.Exit (web.RunChecks ())
  } else ();
  http.HandleFunc "/" handlePage;
  http.HandleFunc "/style.css" handleCSS;
  http.HandleFunc "/fonts/" handleFont;
  http.HandleFunc "/app.wasm" handleBrowser;
  http.HandleFunc "/app.wasm.gz" handleBrowser;
  http.HandleFunc "/wasm_exec.js" handleBrowser;
  http.HandleFunc "/browser.js" handleBrowser;
  http.HandleFunc "/palette.json" handleJSON;
  http.HandleFunc "/palette.pdf" handlePDF;
  let port := portFrom (os.Getenv "PORT");
  fmt.Printf "Palette Forge %s listening on http://localhost:%s\n" web.Version port;
  let err := http.ListenAndServe (":" + port) nil;
  if err != nil then panic err else ()
}
