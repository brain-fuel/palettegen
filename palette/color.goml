module palette

-- Color conversion, pure goml. Hue in degrees, S and L in percent, matching
-- the notation of "Refactoring UI: Color Palettes".

import "fmt"
import "math"
import "strconv"
import "strings"

type RGB := { R : Int; G : Int; B : Int }

type Parsed :=
  | Good (Sh : Shade)
  | Bad

-- Cross-package accessors (constructor patterns don't travel across packages).
let ParsedOk (p : Parsed) : Bool :=
  match p with
  | Good _ => true
  | Bad => false

let ParsedShade (p : Parsed) : Shade :=
  match p with
  | Good sh => sh
  | Bad => Shade { Hex = "#000000", H = 0.0, S = 0.0, L = 0.0 }

let clamp01 (x : Float64) : Float64 :=
  if x < 0.0 then 0.0 else if x > 1.0 then 1.0 else x

-- hsl (degrees, percent, percent) -> rgb in 0..1
let hslChannel (p : Float64) (q : Float64) (t0 : Float64) : Float64 := do {
  let t := if t0 < 0.0 then t0 + 1.0 else if t0 > 1.0 then t0 - 1.0 else t0;
  if t < 1.0 / 6.0 then p + (q - p) * 6.0 * t
  else if t < 0.5 then q
  else if t < 2.0 / 3.0 then p + (q - p) * (2.0 / 3.0 - t) * 6.0
  else p
}

let hslToRGB (h : Float64) (s : Float64) (l : Float64) : RGB := do {
  let hh := normHue h / 360.0;
  let ss := clamp01 (s / 100.0);
  let ll := clamp01 (l / 100.0);
  let q := if ll < 0.5 then ll * (1.0 + ss) else ll + ss - ll * ss;
  let p := 2.0 * ll - q;
  let r := hslChannel p q (hh + 1.0 / 3.0);
  let g := hslChannel p q hh;
  let b := hslChannel p q (hh - 1.0 / 3.0);
  RGB {
    R = Int (math.Round (r * 255.0)),
    G = Int (math.Round (g * 255.0)),
    B = Int (math.Round (b * 255.0))
  }
}

let HSLToHex (h : Float64) (s : Float64) (l : Float64) : String := do {
  let c := hslToRGB h s l;
  fmt.Sprintf "#%02X%02X%02X" c.R c.G c.B
}

let MakeShade (h : Float64) (s : Float64) (l : Float64) : Shade :=
  Shade {
    Hex = HSLToHex h s l,
    H = math.Round (normHue h),
    S = math.Round s,
    L = math.Round l
  }

let RGBOf (sh : Shade) : RGB := hslToRGB sh.H sh.S sh.L

-- Perceived brightness 0..255, the formula Refactoring UI cites:
-- sqrt(0.299 R^2 + 0.587 G^2 + 0.114 B^2).
let LumaOf (sh : Shade) : Float64 := do {
  let c := RGBOf sh;
  let r := Float64 c.R / 255.0;
  let g := Float64 c.G / 255.0;
  let b := Float64 c.B / 255.0;
  math.Sqrt (0.299 * r * r + 0.587 * g * g + 0.114 * b * b) * 255.0
}

let rgbToShade (hex : String) (r0 : Int) (g0 : Int) (b0 : Int) : Shade := do {
  let r := Float64 r0 / 255.0;
  let g := Float64 g0 / 255.0;
  let b := Float64 b0 / 255.0;
  let mx := math.Max r (math.Max g b);
  let mn := math.Min r (math.Min g b);
  let l := (mx + mn) / 2.0;
  let d := mx - mn;
  if d == 0.0
    then Shade { Hex = hex, H = 0.0, S = 0.0, L = math.Round (l * 100.0) }
    else do {
      let s := if l > 0.5 then d / (2.0 - mx - mn) else d / (mx + mn);
      let hRaw :=
        if mx == r then math.Mod ((g - b) / d) 6.0
        else if mx == g then (b - r) / d + 2.0
        else (r - g) / d + 4.0;
      let h := normHue (hRaw * 60.0);
      Shade {
        Hex = hex,
        H = math.Round h,
        S = math.Round (s * 100.0),
        L = math.Round (l * 100.0)
      }
    }
}

let expand3 (t : String) : String :=
  String t[0] + String t[0] + String t[1] + String t[1] + String t[2] + String t[2]

-- Parse "#RRGGBB" or "#RGB" (with or without '#', any case).
let ParseHex (raw : String) : Parsed := do {
  let t0 := strings.ToLower (strings.TrimPrefix (strings.TrimSpace raw) "#");
  let t := if len t0 == 3 then expand3 t0 else t0;
  if len t != 6 then Bad else do {
    let n, err := strconv.ParseInt t 16 32;
    if err != nil then Bad else do {
      let v := Int n;
      let r := v / 65536;
      let g := (v / 256) % 256;
      let b := v % 256;
      Good (rgbToShade ("#" + strings.ToUpper t) r g b)
    }
  }
}
