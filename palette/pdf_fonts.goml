module palette

-- GENERATED by tools/gen_fonts.py. The same SIL OFL 1.1 fonts as the web UI,
-- decompressed to TrueType for fpdf. See LICENSES/ for copyright and terms.
import "encoding/base64"

let decodePDFFont (data : String) : Slice Byte := do {
  let bytes, err := base64.StdEncoding.DecodeString data;
  if err != nil then panic err else ();
  bytes
}

let pdfOverpass : Slice Byte := decodePDFFont ""

let pdfAtkinson : Slice Byte := decodePDFFont ""

let pdfAtkinsonBold : Slice Byte := decodePDFFont ""

let pdfMono : Slice Byte := decodePDFFont ""

let pdfMonoBold : Slice Byte := decodePDFFont ""
